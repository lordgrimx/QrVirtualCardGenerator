<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiNfcReader.ViewModels"
             x:Class="MauiNfcReader.Views.NfcReaderPage"
             x:DataType="vm:NfcReaderViewModel"
             Title="NFC Kart Okuyucu"
             BackgroundColor="#F9FAFB">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Background Gradient -->
        <Rectangle Grid.RowSpan="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FEFCE8" Offset="0.0" />
                    <GradientStop Color="#FEF3C7" Offset="0.5" />
                    <GradientStop Color="#FED7AA" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Simplified Header -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               Padding="16,12"
               HasShadow="True"
               CornerRadius="0,0,20,20"
               Opacity="0.98"
               Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Back Button -->
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="#7C2D12"
                        Padding="6"
                        VerticalOptions="Center"
                        Clicked="OnBackClicked"/>
                
                <!-- Title -->
                <Label Grid.Column="1"
                       Text="NFC Kart Okuyucu"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
                
                <!-- Status Indicator -->
                <Grid Grid.Column="2" VerticalOptions="Center">
                    <Ellipse x:Name="StatusIndicator"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectionColorConverter}}"
                             WidthRequest="12"
                             HeightRequest="12"/>
                </Grid>
            </Grid>
        </Frame>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="16,0,16,16">
            <VerticalStackLayout Spacing="20">
                
                <!-- Connection Status Bar -->
                <Frame BackgroundColor="White"
                       Padding="16"
                       HasShadow="True"
                       CornerRadius="16"
                       Opacity="0.98"
                       Margin="0,0,0,12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Status Message -->
                        <Label Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               FontSize="16"
                               TextColor="#6B7280"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand"/>
                        
                        <!-- Connection Status -->
                        <Frame Grid.Column="1"
                               BackgroundColor="#F9FAFB"
                               Padding="12,8"
                               CornerRadius="12"
                               HasShadow="False">
                            <HorizontalStackLayout Spacing="8">
                                <BoxView WidthRequest="12"
                                         HeightRequest="12"
                                         CornerRadius="6"
                                         Color="{Binding IsConnected, Converter={StaticResource BoolToConnectionColorConverter}}"
                                         VerticalOptions="Center" />
                                <Label Text="{Binding IsConnected, Converter={StaticResource BoolToConnectionStatusConverter}}"
                                       FontSize="14"
                                       TextColor="#6B7280"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>
                </Frame>
                
                <!-- Auto Detection Status -->
                <HorizontalStackLayout Spacing="12" x:Name="AutoDetectStatus" IsVisible="False" Margin="0,0,0,12">
                    <ActivityIndicator IsRunning="True"
                                     Color="#7C2D12"
                                     WidthRequest="16"
                                     HeightRequest="16"/>
                    <Label Text="NFC cihazları algılanıyor..."
                           FontSize="14"
                           TextColor="#7C2D12"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Simplified Reading Section -->
                <VerticalStackLayout x:Name="ReadingSection" Spacing="30" Padding="20,0">
                    <VerticalStackLayout.IsVisible>
                        <OnPlatform x:TypeArguments="x:Boolean">
                            <On Platform="Android" Value="True"/>
                            <On Platform="iOS" Value="True"/>
                            <On Platform="WinUI" Value="True"/>
                        </OnPlatform>
                    </VerticalStackLayout.IsVisible>
                 
                    <!-- Main NFC Reading Area -->
                    <Frame BackgroundColor="White"
                           Padding="40"
                           HasShadow="True"
                           CornerRadius="24"
                           Opacity="0.98">
                        <VerticalStackLayout Spacing="30" HorizontalOptions="Center">
                            
                            <!-- Large NFC Icon with Animation -->
                            <Frame BackgroundColor="#FEF3C7"
                                   WidthRequest="180"
                                   HeightRequest="180"
                                   CornerRadius="90"
                                   Padding="0"
                                   HorizontalOptions="Center"
                                   HasShadow="True">
                                <Grid>
                                    <Label Text="📡"
                                           FontSize="80"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    
                                    <!-- Pulse Animation -->
                                    <Ellipse x:Name="PulseCircle"
                                             Stroke="#7C2D12"
                                             StrokeThickness="4"
                                             IsVisible="{Binding IsReading}"
                                             Opacity="0.4"
                                             WidthRequest="160"
                                             HeightRequest="160"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"/>
                                </Grid>
                            </Frame>

                            <!-- Status Text -->
                            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Label Text="{Binding IsReading, Converter={StaticResource BoolToReadingStatusConverter}}"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="#111827"
                                       HorizontalOptions="Center"/>
                                <Label Text="Kartınızı okuyucuya yaklaştırın"
                                       FontSize="18"
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- Single Large Read Button -->
                            <Button x:Name="ReadCardBtn"
                                    Text="📖 KART OKU"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    HeightRequest="80"
                                    WidthRequest="280"
                                    CornerRadius="20"
                                    Command="{Binding ReadCardCommand}"
                                    IsEnabled="{Binding IsConnected}"
                                    HorizontalOptions="Center">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7C2D12" Offset="0.0" />
                                        <GradientStop Color="#92400E" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.TextColor>White</Button.TextColor>
                            </Button>

                            <!-- Connection Status Indicator -->
                            <Frame BackgroundColor="#F9FAFB"
                                   Padding="16"
                                   CornerRadius="16"
                                   HasShadow="False"
                                   IsVisible="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}">
                                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <Label Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                                    <Label Text="NFC okuyucu bağlı değil"
                                           FontSize="16"
                                           TextColor="#92400E"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Last Read Card - Simplified -->
                    <Frame BackgroundColor="White"
                           Padding="24"
                           HasShadow="True"
                           CornerRadius="16"
                           Opacity="0.98"
                           IsVisible="{Binding LastReadCard, Converter={StaticResource IsNotNullConverter}}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="✅ Son Okunan Kart"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   HorizontalOptions="Center"/>
                            
                            <Grid ColumnSpacing="16" RowSpacing="12" Padding="20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Text="Kart UID:" FontSize="16" TextColor="#6B7280"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding LastReadCard.UidHex}" FontSize="16" FontAttributes="Bold" TextColor="#111827"/>
                                
                                <Label Grid.Row="1" Grid.Column="0" Text="Okuma Zamanı:" FontSize="16" TextColor="#6B7280"/>
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding LastReadCard.ReadAt, StringFormat='{0:HH:mm:ss}'}" FontSize="16" FontAttributes="Bold" TextColor="#111827"/>
                            </Grid>

                            <Button Text="🔍 ÜYE BİLGİLERİNİ GÖRÜNTÜLE"
                                    FontSize="16"
                                    BackgroundColor="#F3F4F6"
                                    TextColor="#7C2D12"
                                    CornerRadius="16"
                                    HeightRequest="56"
                                    Command="{Binding VerifyQrCommand}"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
                <!-- End of Reading Section -->

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
